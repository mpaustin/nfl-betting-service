<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
<!--database mapping-->
        <property name="hibernate.connection.url">${DATABASE_URL}</property>
        <property name="hibernate.connection.username">${DATABASE_USERNAME}</property>
        <property name="hibernate.connection.password">${DATABASE_PASSWORD}</property>
<!--driver mapping-->
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQL9Dialect</property>
<!--pretty SQL-->
        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">false</property>
<!--class mappings-->
        <mapping class="com.ex.app.entities.User" />
        <mapping class="com.ex.app.entities.Game" />
        <mapping class="com.ex.app.entities.Bet" />
        <mapping class="com.ex.app.entities.Stat" />
    </session-factory>
</hibernate-configuration>
